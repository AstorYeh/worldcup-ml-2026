# 複製本檔為 .env 並填入實際值（.env 已被 .gitignore 排除，不會上傳）

# The Odds API 金鑰 — https://the-odds-api.com 免費註冊（月 500 次，每天 1 次綽綽有餘）
ODDS_API_KEY=

# GitHub Personal Access Token（需 repo push 權限）
# 建立：GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# 你的 repo（owner/name）
GITHUB_REPO=AstorYeh/worldcup-ml-2026

# 推送分支
GIT_BRANCH=main

# 每天觸發時刻（UTC 小時）：2 = 台灣早上 10:00、22 = 台灣早上 6:00
TARGET_HOUR=2
